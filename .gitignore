# ---- Secrets: never commit these ----
.env
.env.*
*.pem
*.key
credentials
config
.aws/

# ---- Data: too large for git, and often licence-restricted ----
# NOTE: `data/` alone would exclude the directory itself, and git cannot
# re-include a file inside an excluded directory -- the .gitkeep negations
# below would silently do nothing. Excluding *contents* while re-including
# directories lets git descend and keeps the folder structure in the repo.
data/**
!data/**/
!data/**/.gitkeep
*.csv
*.tsv
*.parquet
*.feather
*.zip
*.tar.gz
*.jsonl

# ---- Model checkpoints: large binaries, regenerable ----
models/**
!models/**/
!models/**/.gitkeep
*.pkl
*.joblib
*.pt
*.pth
*.h5
*.onnx
*.safetensors

# ---- Python ----
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# ---- Jupyter ----
*.ipynb_checkpoints
.jupyter/

# ---- macOS ----
.DS_Store

# ---- Logs / scratch ----
*.log
scratch/
tmp/
