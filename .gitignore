# ---- Secrets: never commit these ----
.env
.env.*
*.pem
*.key
credentials
.aws/

# ---- Challenge data: 2.4 GB, provided by organisers, never commit ----
# The dataset lives in student_resource/dataset/{train,test}/ and is ~2.4 GB.
# *.tsv below covers it globally, but the explicit rule documents intent.
student_resource/dataset/**
*.tsv
*.csv
*.parquet
*.feather
*.zip
*.tar.gz
*.jsonl

# ---- Generated outputs: large and regenerable from the pipeline ----
student_resource/output/**
Lassi_submission/output/**

# ---- Model artefacts / caches: large binaries, regenerable ----
# Leading '**/' so this matches at any depth, not just the repo root.
**/artifacts/
artifacts/**
*.pkl
*.joblib
*.npz
*.npy
*.pt
*.pth
*.onnx
*.safetensors

# ---- Python ----
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# ---- macOS ----
.DS_Store

# ---- Logs / scratch ----
*.log
scratch/
tmp/
